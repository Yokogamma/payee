VITE_PROXY_URL=http://localhost:8787

# Root of trust for restore (C2). Comma-separated Arweave wallet address(es) of
# the proxy's server wallet. Discover the value via `GET <proxy>/wallet-address`.
# Restore is fail-closed: without this, fetching notes throws instead of trusting
# arbitrary on-chain transactions. Production builds fail if this is empty.
VITE_TRUSTED_OWNERS=Vgd_c_CcaG_DmGQ-dIvu_AVfq0bS1Wav9sjpQyeEPdE
