{
  "name": "eternal-notes-proxy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"console.error('Production deploys go through the trusted workflow (Deploy Worker — dev) with a candidate SHA: a local wrangler deploy bypasses the floor gate, the Environment and the release lock. Use deploy:staging for staging.'); process.exit(1)\"",
    "check:staging-config": "node scripts/check-staging-config.mjs",
    "predeploy:staging": "npm run check:staging-config",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:staging:check": "wrangler deploy --env staging --dry-run",
    "smoke:v3": "node scripts/smoke-v3.mjs",
    "smoke:v4": "node scripts/smoke-v4.mjs",
    "seed-invite": "wrangler dev --test-scheduled",
    "test": "vitest run && vitest run -c vitest.direct.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "arweave": "^1.15.5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": "^24.19.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
