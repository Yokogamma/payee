{
  "name": "matamata-notes-proxy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:staging-config": "node scripts/check-staging-config.mjs",
    "predeploy:staging": "npm run check:staging-config",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:staging:check": "wrangler deploy --env staging --dry-run",
    "smoke:v3": "node scripts/smoke-v3.mjs",
    "smoke:v4": "node scripts/smoke-v4.mjs",
    "seed-invite": "wrangler dev --test-scheduled",
    "test": "vitest run && vitest run -c vitest.direct.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "~5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "arweave": "^1.15.5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
